    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\n\n// Находим текст ответа Gemini\nlet rawText = inputData.text || \n              inputData.output || \n              inputData.content || \n              (inputData.candidates && inputData.candidates[0]?.content?.parts[0]?.text) ||\n              JSON.stringify(inputData);\n\n// Очищаем от ```json\nif (typeof rawText === 'string') {\n  rawText = rawText.replace(/```json/gi, '').replace(/```/g, '').trim();\n}\n\nlet parsedData = {};\ntry {\n  parsedData = typeof rawText === 'string' ? JSON.parse(rawText) : rawText;\n} catch (e) {\n  parsedData = { error: \"Не удалось распарсить JSON\", raw: rawText };\n}\n\n// Достаем ссылку на фото из узла Google Drive или Telegram\nlet photoUrl = \"\";\ntry {\n  photoUrl = $('Google Drive').first().json.webViewLink || \"\";\n} catch (e) {\n  // Если Google Drive отключен, берем ID из Telegram\n  try {\n    const fileId = $('Telegram Trigger').first().json.message.photo.slice(-1)[0].file_id;\n    photoUrl = `https://api.telegram.org/file/bot${fileId}`; \n  } catch (err) {\n    photoUrl = \"\";\n  }\n}\n\nparsedData.photo_link = photoUrl;\n\nreturn [{ json: parsedData }];"
      },
