      "parameters": {
        "jsCode": "// Пробуем достать ответ Gemini напрямую из вызова или из контекста\nlet rawText = \"\";\n\ntry {\n  // Вариант 1: Из входящего потока\n  rawText = $input.first().json.candidates[0].content.parts[0].text;\n} catch (e) {\n  // Вариант 2: Запасной — прямо из ноды Gemini по имени\n  rawText = $('Analyze an image').first().json.candidates[0].content.parts[0].text;\n}\n\n// Очищаем и парсим JSON-текст\nconst cleanJsonText = rawText.replace(/```json|```/g, '').trim();\nconst parsedData = JSON.parse(cleanJsonText);\n\n// --- БЛОК ПОДМЕНЫ МАРШРУТА ПО НОМЕРАМ МАШИН ---\n// Список спецмашин (на кириллице и латинице)\nconst specialTrucks = ['АІ5714ТВ', 'АІ5713ТВ', 'АА9347ТР', 'AI5714TB', 'AI5713TB', 'AA9347TP']; \n\n// Проверяем номер машины из ТТН\nconst currentTruck = (parsedData.truck || '').replace(/\\s+/g, '').toUpperCase();\nconst isSpecial = specialTrucks.some(num => currentTruck.includes(num));\n\nif (isSpecial) {\n  const truckInfo = parsedData.truck || '';\n  const trailerInfo = parsedData.trailer ? `(причіп ${parsedData.trailer})` : '';\n  \n  // Достаем маршрут (города), который сгенерировал Gemini, отсекая начальный шаблон ПММ\n  // Извлечет всё, что идет после номера прицепа или тягача (например, \"м. Житомир - м. Київ\")\n  let citiesRoute = '';\n  if (parsedData.route) {\n    const routeParts = parsedData.route.split(/\\)\\s*|\\b[A-Z0-9]{2,8}\\b/i);\n    citiesRoute = routeParts[routeParts.length - 1]?.trim() || '';\n  }\n\n  // Собираем итоговую строку для тралов с замененой на а/м и сохранением маршрута\n  parsedData.route = `Послуги з перевезення а/м автомобіль ${truckInfo} ${trailerInfo} ${citiesRoute}`.replace(/\\s+/g, ' ').trim();\n}\n// ---------------------------------------------\n\n// Добавляем ссылку на файл из Google Drive (если она есть)\ntry {\n  if ($('Google Drive').first()?.json?.webViewLink) {\n    parsedData['webViewLink'] = $('Google Drive').first().json.webViewLink;\n  }\n} catch (e) {}\n\nreturn [{ json: parsedData }];"
      },
